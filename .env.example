# ========================================================
# JobPulse Production Environment Configuration
# ========================================================

# Application Details
APP_NAME="JobPulse"
APP_TAGLINE="Automated AI Career Matchmaker"

# Ingestion Sources (Enable/Disable live public APIs)
ENABLE_REMOTEOK=true
ENABLE_JOBICY=true
ENABLE_ARBEITNOW=true
ENABLE_REMOTIVE=true

# Background Automated Crawler Cadence (in seconds; default 3600 = 60 minutes)
CRAWLER_INTERVAL_SECONDS=3600

# ========================================================
# Production Transactional Email Delivery (RFC 8058 Compliant)
# ========================================================
# Options:
# 1. Resend: smtp.resend.com, port 587, user "resend", pass "re_..."
# 2. SendGrid: smtp.sendgrid.net, port 587, user "apikey", pass "SG...."
# 3. AWS SES: email-smtp.<region>.amazonaws.com, port 587
# 4. Custom SMTP: any standard TLS mail server
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_production_api_key_or_password_here
SMTP_FROM="JobPulse Job Alerts <alerts@yourdomain.com>"
SMTP_STARTTLS=true

# Fallback Simulation (Set to false in production to enforce real delivery)
SIMULATE_EMAIL_IF_UNCONFIGURED=true
